#!/bin/sh
# Runs the smoke suite against a fresh Monokulo on this machine's network
# (docker/monokulo-smoke.toml), then stops it. The shop must be up and the
# module installed (scripts/test up && scripts/test install).
#
# Which Monokulo:
#   MONOKULO_BIN=/path/to/monokulo   a binary built from the pinned commit, or
#   MONOKULO_IMAGE=ghcr.io/...       its Docker image (the default:
#                                    monokulo:smoke, built by CI from the
#                                    commit in tests/vectors/PIN)
set -eu
cd "$(dirname "$0")/.."

url=http://localhost:8081
# Another Monokulo on the port would be tested in this one's place.
if curl -s -o /dev/null "$url/"; then
	echo "something already answers on $url: stop it, then run this again" >&2
	exit 1
fi
# Its exchange rates' stand-in (tests/Support/fake-rates.php).
if curl -s -o /dev/null http://localhost:18094/; then
	echo "something already answers on localhost:18094: stop it, then run this again" >&2
	exit 1
fi
# Its onion listener (docker/monokulo-smoke.toml).
if curl -s -o /dev/null http://127.0.0.1:18093/; then
	echo "something already answers on 127.0.0.1:18093: stop it, then run this again" >&2
	exit 1
fi

data=$(mktemp -d)
key=$(od -An -tx1 -N32 /dev/urandom | tr -d ' \n')

if [ -n "${MONOKULO_BIN:-}" ]; then
	MONOKULO_ENCRYPTION_KEY=$key "$MONOKULO_BIN" --options docker/monokulo-smoke.toml \
		--database-path "$data/monokulo.db" --logging-format json > "$data/monokulo.log" 2>&1 &
	pid=$!
	stop() { kill "$pid" 2>/dev/null || true; }
else
	chmod 777 "$data"
	docker run -d --rm --name monokulo-smoke --network host \
		-e MONOKULO_ENCRYPTION_KEY="$key" \
		-v "$PWD/docker/monokulo-smoke.toml:/etc/monokulo.toml:ro" -v "$data:/data" \
		"${MONOKULO_IMAGE:-monokulo:smoke}" monokulo --options /etc/monokulo.toml \
		--database-path /data/monokulo.db --logging-format json > /dev/null
	stop() { docker logs monokulo-smoke > "$data/monokulo.log" 2>&1 || true; docker stop monokulo-smoke > /dev/null 2>&1 || true; }
fi

# The exchange rates' stand-in, served from the shop's container (on this
# machine's network): a PHP router in the background.
compose() {
	docker compose -f docker/compose.yaml "$@"
}
compose exec -T -d prestashop sh -c 'rm -f /tmp/monokulo-smoke-rates-down; echo $$ > /tmp/monokulo-smoke-rates.pid; exec php -S localhost:18094 /repo/tests/Support/fake-rates.php'
unserve() {
	compose exec -T prestashop sh -c 'test -f /tmp/monokulo-smoke-rates.pid && kill "$(cat /tmp/monokulo-smoke-rates.pid)"; rm -f /tmp/monokulo-smoke-rates.pid /tmp/monokulo-smoke-rates-down' 2>/dev/null || true
}

cleanup() {
	status=$?
	stop
	unserve
	if [ "$status" != 0 ]; then
		echo "--- Monokulo's log ---"
		tail -n 100 "$data/monokulo.log" 2>/dev/null || true
	fi
	rm -rf "$data"
	exit "$status"
}
trap cleanup EXIT INT TERM

for i in $(seq 1 60); do
	if curl -fs -o /dev/null "$url/status" || curl -s -o /dev/null -w '%{http_code}' "$url/" | grep -q 302; then
		break
	fi
	sleep 1
done

MONOKULO_URL=$url scripts/test smoke "$@"
